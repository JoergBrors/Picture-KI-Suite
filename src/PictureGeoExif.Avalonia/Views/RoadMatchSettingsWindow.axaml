<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PictureGeoExif.Desktop.ViewModels"
        x:Class="PictureGeoExif.Desktop.Views.RoadMatchSettingsWindow"
        x:DataType="vm:RoadMatchSettingsViewModel"
        Title="Trassen an Wege anlegen – Einstellungen" Width="560" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="6">
    <TextBlock Text="Valhalla-kompatibler Map-Matching-Server" FontWeight="SemiBold" />
    <TextBox Text="{Binding Url}" />
    <TextBlock Classes="hint" Text="Standard: öffentlicher Demo-Server des FOSSGIS e.V. (fair use, höchstens 1 Anfrage pro Sekunde). Für den Firmeneinsatz einen eigenen Server eintragen." />
    <TextBlock Text="Profil" FontWeight="SemiBold" Margin="0,8,0,0" />
    <ComboBox ItemsSource="{x:Static vm:RoadMatchSettingsViewModel.Profiles}" SelectedItem="{Binding Profile}" MinWidth="200" />
    <TextBlock Text="{Binding Deviation, StringFormat='Maximaler Abstand zum Weg: {0:F0} m'}" Margin="0,8,0,0" />
    <Slider Minimum="5" Maximum="200" Value="{Binding Deviation}" />
    <TextBlock Text="{Binding Error}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Standard" Command="{Binding DefaultsCommand}" />
      <Button Content="Abbrechen" IsCancel="True" Click="Cancel_Click" />
      <Button Content="OK" IsDefault="True" Classes="accent" Click="Ok_Click" />
    </StackPanel>
  </StackPanel>
</Window>
